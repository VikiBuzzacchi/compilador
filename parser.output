Grammar

    0 $accept: program $end

    1 program: var_decl_list method_decl_list
    2        | method_decl_list

    3 var_decl_list: var_decl_list var_decl
    4              | var_decl

    5 var_decl: type id_list ';'

    6 id_list: ID
    7        | ID ',' id_list

    8 method_decl_list: method_decl_list method_decl
    9                 | method_decl

   10 method_decl: type ID '(' param_list ')' block
   11            | VOID ID '(' param_list ')' block

   12 param_list: param_list_ne
   13           | ε

   14 param_list_ne: type ID
   15              | type ID ',' param_list_ne

   16 block: '{' var_decl_list statement_list '}'

   17 statement_list: statement statement_list
   18               | ε

   19 type: INT
   20     | BOOLEAN
   21     | FLOAT

   22 statement: ID '=' expr ';'
   23          | method_call ';'
   24          | IF '(' expr ')' block
   25          | IF '(' expr ')' block ELSE block
   26          | WHILE '(' expr ')' block
   27          | RETURN expr ';'
   28          | RETURN ';'
   29          | ';'
   30          | block
   31          | error ';'

   32 method_call: ID '(' expr_list ')'

   33 expr_list: expr_list_ne
   34          | ε

   35 expr_list_ne: expr
   36             | expr ',' expr_list_ne

   37 expr: ID
   38     | method_call
   39     | literal
   40     | expr OR_OP expr
   41     | expr AND_OP expr
   42     | expr EQ_OP expr
   43     | expr '<' expr
   44     | expr '>' expr
   45     | expr '+' expr
   46     | expr '-' expr
   47     | expr '*' expr
   48     | expr '/' expr
   49     | expr '%' expr
   50     | '-' expr
   51     | '!' expr
   52     | '(' expr ')'

   53 literal: CONSTINT
   54        | CONSTFLOAT
   55        | bool_literal

   56 bool_literal: TRUE
   57             | FALSE


