    '<' (60) 43
    '=' (61) 22
    '>' (62) 44
    '{' (123) 16
    '}' (125) 16
    error (256) 31
    INT (258) 19
    BOOLEAN (259) 20
    TRUE (260) 56
    FALSE (261) 57
    ID <id> (262) 6 7 10 11 14 15 22 32 37
    CONSTINT <val> (263) 53
    CONSTFLOAT <fval> (264) 54
    RETURN (265) 27 28
    VOID (266) 11
    ELSE (267) 25
    IF (268) 24 25
    WHILE (269) 26
    FLOAT (270) 21
    OR_OP (271) 40
    AND_OP (272) 41
    EQ_OP (273) 42
    UMINUS (274)
    UNOT (275)


